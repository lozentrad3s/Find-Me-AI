{
  "name": "find-me",
  "version": "0.1.0",
  "private": true,
  "description": "Find Me - AI location assistant. Resolution engine + harness.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "harness": "tsx src/harness/env-mock.ts",
    "harness:jos": "tsx src/harness/env-mock.ts --city=jos",
    "harness:abuja": "tsx src/harness/env-mock.ts --city=abuja",
    "typecheck": "tsc --noEmit",
    "harness:models": "tsx src/harness/compare.ts",
    "harness:intents": "tsx src/harness/intents.ts",
    "check:parse": "tsx scripts/parse-check.ts",
    "check:resolve": "tsx scripts/resolve-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/genai": "^2.21.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.43.0",
    "next": "^15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "supabase": "^2.117.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
