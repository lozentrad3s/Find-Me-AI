# ---------------------------------------------------------------------------
# Find Me — environment
#
# Copy to .env.local and fill in what you have.
#
# The map, geocoding, place search and routing all work with this file
# completely blank — they run on OpenStreetMap, which needs no key and no
# billing account. Only the AI assistant needs a key.
# ---------------------------------------------------------------------------

# --- Maps and places -------------------------------------------------------
# "osm" (default, free) | "google" (needs a key) | "mock" (fixtures, offline)
PLACES_PROVIDER=osm
GEOCODING_PROVIDER=osm

# Identifies this app to Nominatim. Their usage policy requires a real
# User-Agent, and requests without one get refused.
#
# Set this properly before deploying anywhere public. It is how OpenStreetMap
# contacts you about a problem instead of silently blocking the IP — and cloud
# provider IP ranges are already heavily abused by other people's apps, so a
# fresh deployment starts with less goodwill than your laptop had.
OSM_USER_AGENT=FindMe/0.1 (https://your-deployment.vercel.app; you@example.com)

# Routing. Defaults to the public OSRM demo server, which has no SLA and asks
# that you not run production traffic through it. Point this at your own
# instance before real users arrive.
# OSRM_BASE_URL=https://router.project-osrm.org

# Only needed if PLACES_PROVIDER or GEOCODING_PROVIDER is "google".
GOOGLE_MAPS_API_KEY=

# --- Traffic ---------------------------------------------------------------
# OpenStreetMap and OSRM have NO traffic data — OSRM travel times are free-flow
# estimates from speed limits and are identical at 3am and 5pm on a Friday.
#
# Without a key here, check_route_conditions reports that traffic is unknown and
# the assistant is instructed to say so. That is deliberate: a fabricated
# "moderate traffic" sounds exactly as confident as a measured one.
#
# TomTom has a free tier of roughly 2,500 requests/day and covers Nigerian
# cities: https://developer.tomtom.com
TOMTOM_API_KEY=

# --- AI --------------------------------------------------------------------
# Without this the map, search and routing still work; the assistant does not.
ANTHROPIC_API_KEY=

# Small and cheap by default. Both are overridable.
#   parse — bounded extraction, sits in the latency path of every search
#   chat  — the tool-calling assistant
# Move ANTHROPIC_CHAT_MODEL to claude-sonnet-5 if tool selection gets unreliable;
# that is the first thing to try before blaming the prompt.
ANTHROPIC_PARSE_MODEL=claude-haiku-4-5
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

# --- Gemini (free tier, no card required) ----------------------------------
# Get a key in about a minute at https://aistudio.google.com/apikey
#
# Whichever key is present is used automatically — set this and the assistant
# works, no LLM_PROVIDER needed. If both are set, Anthropic wins unless you
# force it with LLM_PROVIDER=gemini.
GEMINI_API_KEY=
# NOTE: gemini-3.8-flash is capped at 20 requests PER DAY on the free tier.
# 3.7 and 3.6 flash have workable limits on the same key.
GEMINI_PARSE_MODEL=gemini-3.7-flash
GEMINI_CHAT_MODEL=gemini-3.7-flash

# When the map cannot identify a named place, search the web for its official
# name and address, then resolve THAT instead of answering "not found".
# Measured: OpenStreetMap has nothing called "Clover" anywhere in Abuja, while
# the web lists Clover Hospital — so without this, a real hospital people
# navigate to daily is unfindable.
#
# The search never supplies coordinates, only better words for the geocoder.
# It runs on the Gemini key (Google Search grounding) and therefore spends the
# same small free-tier quota, so it only runs after the map search came back
# empty. Set to "off" to disable.
# WEB_PLACE_SEARCH=on
# GEMINI_SEARCH_MODEL=gemini-3.7-flash

# Let Gemini ground answers on Google Search and Google Maps.
#
# Off by default on purpose. Google's Nigeria place data is genuinely better
# than OpenStreetMap's, so this would improve answers — but it routes around
# this project's own resolution engine, which is the thing being built and
# measured. Turn it on for a deliberate comparison, not as a default, or the
# harness numbers stop meaning anything.
GEMINI_GROUNDING=false

# How hard Gemini thinks before replying: MINIMAL | LOW | MEDIUM | HIGH.
# LOW by default — replies are phrasing over tool results, not reasoning, and
# the default level spent seconds thinking before every answer.
# GEMINI_THINKING_LEVEL=LOW

# Recognised requests ("closest restaurant", "traffic on Sani Abacha Way",
# "weather in Maitama", "take me there") are answered straight from their
# results in about a second, instead of waiting 5-30s for the model to
# rephrase them — and without spending the free tier's few dozen daily calls.
# Set to "off" to have the model phrase every answer.
# FAST_REPLIES=on

# Which parser the RESOLUTION ENGINE uses: "rules" (default) | "anthropic" |
# "gemini".
#
# Defaults to "rules" even when a model key is present. The rule-based parser
# scores 88% on the harness and costs nothing, while routing every search
# through a model spent Gemini's ~20 free calls a day on extraction and left
# none for conversation. The assistant is chosen separately and always uses a
# model when a key exists.
# LLM_PROVIDER=rules

# --- Safety ----------------------------------------------------------------
# SOS alerts and community reports need Supabase to be durable. Without it
# they run in memory — which works on localhost and says so on screen, but on
# Vercel an alert can vanish when an instance recycles. Apply every migration
# with `npx supabase db push`, then set the Supabase vars below. 0002 creates
# the tables; the later ones grant the service role access to them, and on
# projects created after May 2026 every safety write fails without that grant.

# Salts the hash that stops a device confirming its own incident report.
# Any long random string. Never shown to clients.
SAFETY_SALT=

# Partnered security organisations that receive SOS alerts by webhook.
# Empty until an agreement exists — the SOS screen then says plainly that no
# agency was notified. JSON array; each partner covers a circle:
# SECURITY_PARTNERS=[{"id":"fct-pilot","name":"FCT Command Pilot","webhook":"https://...","token":"...","centre":{"lat":9.0579,"lng":7.4951},"radiusM":30000}]
SECURITY_PARTNERS=

# SMS gateway for next-of-kin alerts (Termii or Africa's Talking). Not wired
# to a provider yet; setting it changes the SMS channel from "unavailable".
SMS_GATEWAY_URL=

# --- Persistence -----------------------------------------------------------
# "file" writes resolution records to .data/ — fine for the harness.
RESOLUTION_STORE=file

# Supabase. Not required to run locally.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
