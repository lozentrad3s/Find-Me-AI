{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "functions": {
    "src/app/api/chat/route.ts": { "maxDuration": 60 },
    "src/app/api/resolve/route.ts": { "maxDuration": 30 },
    "src/app/api/nearby/route.ts": { "maxDuration": 30 },
    "src/app/api/health/route.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/chat",
      "headers": [{ "key": "X-Accel-Buffering", "value": "no" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), microphone=(self), camera=()"
        }
      ]
    }
  ]
}
